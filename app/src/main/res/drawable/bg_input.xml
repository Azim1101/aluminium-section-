<?xml version="1.0" encoding="utf-8"?>
<!-- One UI text field: grey fill, 12dp radius, violet focus ring -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/card"/>
            <corners android:radius="@dimen/ou_radius_small"/>
            <stroke android:width="1.6dp" android:color="@color/acc"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/card2"/>
            <corners android:radius="@dimen/ou_radius_small"/>
        </shape>
    </item>
</selector>
