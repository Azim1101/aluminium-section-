<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="24dp" android:gravity="center">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Enter PIN to edit prices" android:textSize="13sp"
        android:textColor="@color/mut" android:layout_marginBottom="14dp"/>

    <EditText android:id="@+id/etPin"
        android:layout_width="180dp" android:layout_height="54dp"
        android:background="@drawable/bg_input"
        android:gravity="center" android:inputType="numberPassword"
        android:maxLength="8" android:textSize="24sp" android:textStyle="bold"
        android:letterSpacing="0.4" android:textColor="@color/acc"/>
</LinearLayout>
