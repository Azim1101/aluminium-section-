<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="44dp"
    android:orientation="horizontal"
    android:baselineAligned="false">

    <!-- NO -->
    <TextView
        android:id="@+id/tvNo"
        android:layout_width="0dp"
        android:layout_weight="0.9"
        android:layout_height="match_parent"
        android:background="@drawable/cell_no"
        android:gravity="center"
        android:textSize="12.5sp"
        android:textStyle="bold"
        android:textColor="@color/mut"/>

    <!-- HEIGHT -->
    <EditText
        android:id="@+id/etH"
        android:layout_width="0dp"
        android:layout_weight="2.3"
        android:layout_height="match_parent"
        android:background="@drawable/cell"
        android:gravity="center"
        android:inputType="numberDecimal"
        android:textSize="14.5sp"
        android:textStyle="bold"
        android:textColor="@color/txt"
        android:textColorHint="#C7CFDB"
        android:hint="—"
        android:maxLines="1"
        android:padding="1dp"
        android:imeOptions="actionNext"/>

    <!-- WIDTH -->
    <EditText
        android:id="@+id/etW"
        android:layout_width="0dp"
        android:layout_weight="2.3"
        android:layout_height="match_parent"
        android:background="@drawable/cell"
        android:gravity="center"
        android:inputType="numberDecimal"
        android:textSize="14.5sp"
        android:textStyle="bold"
        android:textColor="@color/txt"
        android:textColorHint="#C7CFDB"
        android:hint="—"
        android:maxLines="1"
        android:padding="1dp"
        android:imeOptions="actionNext"/>

    <!-- SUTTER -->
    <TextView
        android:id="@+id/tvSutter"
        android:layout_width="0dp"
        android:layout_weight="1.2"
        android:layout_height="match_parent"
        android:background="@drawable/cell"
        android:gravity="center"
        android:textSize="14.5sp"
        android:textStyle="bold"
        android:textColor="@color/acc"/>

    <!-- SYSTEM  Z / D -->
    <TextView
        android:id="@+id/tvSys"
        android:layout_width="0dp"
        android:layout_weight="1.1"
        android:layout_height="match_parent"
        android:background="@drawable/cell"
        android:gravity="center"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"/>

    <!-- RP GRILL -->
    <EditText
        android:id="@+id/etRp"
        android:layout_width="0dp"
        android:layout_weight="1.5"
        android:layout_height="match_parent"
        android:background="@drawable/cell"
        android:gravity="center"
        android:inputType="number"
        android:textSize="14.5sp"
        android:textStyle="bold"
        android:textColor="@color/cRp"
        android:textColorHint="#F0A9CB"
        android:hint="—"
        android:maxLines="1"
        android:padding="1dp"/>

    <!-- delete -->
    <TextView
        android:id="@+id/btnDel"
        android:layout_width="0dp"
        android:layout_weight="0.9"
        android:layout_height="match_parent"
        android:background="@drawable/cell"
        android:gravity="center"
        android:text="✕"
        android:textSize="14sp"
        android:textColor="#C7CFDB"/>
</LinearLayout>
