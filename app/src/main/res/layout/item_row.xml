<?xml version="1.0" encoding="utf-8"?>
<!-- ALU Window v3.0.0 — One UI table row (48dp touch target) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:orientation="horizontal"
    android:baselineAligned="false">

    <TextView
        android:id="@+id/tvNo"
        android:layout_width="0dp"
        android:layout_weight="0.9"
        android:layout_height="match_parent"
        android:background="@drawable/cell_no"
        android:gravity="center"
        android:textSize="12.5sp"
        android:textStyle="bold"
        android:textColor="@color/mut"/>

    <EditText
        android:id="@+id/etH"
        android:layout_width="0dp"
        android:layout_weight="2.3"
        android:layout_height="match_parent"
        android:background="@drawable/cell"
        android:gravity="center"
        android:inputType="numberDecimal"
        android:textSize="14.5sp"
        android:textStyle="bold"
        android:textColor="@color/txt"
        android:textColorHint="@color/hint"
        android:hint="—"
        android:maxLines="1"
        android:padding="1dp"
        android:imeOptions="actionNext"/>

    <EditText
        android:id="@+id/etW"
        android:layout_width="0dp"
        android:layout_weight="2.3"
        android:layout_height="match_parent"
        android:background="@drawable/cell"
        android:gravity="center"
        android:inputType="numberDecimal"
        android:textSize="14.5sp"
        android:textStyle="bold"
        android:textColor="@color/txt"
        android:textColorHint="@color/hint"
        android:hint="—"
        android:maxLines="1"
        android:padding="1dp"
        android:imeOptions="actionNext"/>

    <TextView
        android:id="@+id/tvSutter"
        android:layout_width="0dp"
        android:layout_weight="1.2"
        android:layout_height="match_parent"
        android:background="@drawable/cell"
        android:gravity="center"
        android:textSize="14.5sp"
        android:textStyle="bold"
        android:textColor="@color/cSutter"/>

    <TextView
        android:id="@+id/tvSys"
        android:layout_width="0dp"
        android:layout_weight="1.1"
        android:layout_height="match_parent"
        android:background="@drawable/cell"
        android:gravity="center"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@color/onAcc"/>

    <EditText
        android:id="@+id/etRp"
        android:layout_width="0dp"
        android:layout_weight="1.5"
        android:layout_height="match_parent"
        android:background="@drawable/cell"
        android:gravity="center"
        android:inputType="number"
        android:textSize="14.5sp"
        android:textStyle="bold"
        android:textColor="@color/cRp"
        android:textColorHint="@color/hint"
        android:hint="—"
        android:maxLines="1"
        android:padding="1dp"/>

    <TextView
        android:id="@+id/btnDel"
        android:layout_width="0dp"
        android:layout_weight="0.9"
        android:layout_height="match_parent"
        android:background="@drawable/cell"
        android:gravity="center"
        android:text="✕"
        android:textSize="14sp"
        android:textColor="@color/mut"/>
</LinearLayout>
