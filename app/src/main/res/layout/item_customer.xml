<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:baselineAligned="false"
    android:background="@drawable/bg_card" android:padding="12dp"
    android:layout_marginBottom="8dp" android:gravity="center_vertical">

    <LinearLayout android:layout_width="0dp" android:layout_weight="1"
        android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:id="@+id/cuName" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="15sp"
            android:textStyle="bold" android:textColor="@color/txt"/>
        <TextView android:id="@+id/cuInfo" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="11.5sp"
            android:textColor="@color/mut" android:layout_marginTop="2dp"/>
        <TextView android:id="@+id/cuMeta" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="10.5sp"
            android:textColor="@color/acc" android:layout_marginTop="3dp"/>
    </LinearLayout>

    <TextView android:id="@+id/cuLoad" android:layout_width="wrap_content"
        android:layout_height="34dp" android:gravity="center"
        android:paddingStart="12dp" android:paddingEnd="12dp"
        android:text="LOAD" android:textSize="11sp" android:textStyle="bold"
        android:textColor="#FFFFFF" android:background="@drawable/bg_chip"/>

    <TextView android:id="@+id/cuDel" android:layout_width="34dp"
        android:layout_height="34dp" android:gravity="center" android:text="✕"
        android:textSize="15sp" android:textColor="@color/red"/>
</LinearLayout>
