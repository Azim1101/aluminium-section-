<?xml version="1.0" encoding="utf-8"?>
<!-- ALU Window v3.0.0 — One UI customer card -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:minHeight="72dp"
    android:orientation="horizontal" android:baselineAligned="false"
    android:background="@drawable/bg_card"
    android:paddingStart="18dp" android:paddingEnd="10dp"
    android:paddingTop="14dp" android:paddingBottom="14dp"
    android:layout_marginBottom="10dp" android:gravity="center_vertical">

    <LinearLayout android:layout_width="0dp" android:layout_weight="1"
        android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:id="@+id/cuName" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="16sp"
            android:textColor="@color/txt" android:letterSpacing="-0.01"/>
        <TextView android:id="@+id/cuInfo" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="12.5sp"
            android:textColor="@color/mut" android:layout_marginTop="3dp"/>
        <TextView android:id="@+id/cuMeta" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="11.5sp"
            android:textStyle="bold"
            android:textColor="@color/accText" android:layout_marginTop="5dp"/>
    </LinearLayout>

    <!-- One UI tonal pill -->
    <TextView android:id="@+id/cuLoad" android:layout_width="wrap_content"
        android:layout_height="38dp" android:gravity="center"
        android:paddingStart="18dp" android:paddingEnd="18dp"
        android:text="Load" android:textSize="13sp" android:textStyle="bold"
        android:letterSpacing="0.01"
        android:textColor="@color/accText"
        android:background="@drawable/bg_btn_tonal"/>

    <TextView android:id="@+id/cuDel" android:layout_width="40dp"
        android:layout_height="40dp" android:gravity="center"
        android:background="@drawable/bg_icon_chip"
        android:text="✕" android:textSize="15sp"
        android:textColor="@color/red"/>
</LinearLayout>
