<?xml version="1.0" encoding="utf-8"?>
<!--
  ALU Window v3.0.0 — One UI manual cutting screen.
  Solid blue app-bar ki jagah One UI ka flat large-title header + back arrow.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/bg"
        android:paddingStart="10dp"
        android:paddingEnd="20dp"
        android:paddingTop="10dp"
        android:paddingBottom="8dp">

        <ImageButton
            android:id="@+id/btnManualBack"
            style="@style/HeaderIcon"
            android:layout_marginStart="0dp"
            android:src="@drawable/ic_v2_back"
            android:contentDescription="Back"
            app:tint="@color/txt"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Manual cutting"
                android:textColor="@color/txt"
                android:textSize="22sp"
                android:textStyle="bold"
                android:letterSpacing="-0.02"
                android:includeFontPadding="false"/>

            <TextView
                android:id="@+id/tvManualUnit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/mut"
                android:textSize="12.5sp"/>
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/manualTabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_seg_track"
        app:tabIndicatorColor="@color/acc"
        app:tabIndicatorHeight="0dp"
        app:tabBackground="@drawable/bg_seg_tab"
        app:tabSelectedTextColor="@color/onAcc"
        app:tabTextColor="@color/mut"
        app:tabRippleColor="@color/transparent"
        app:tabMode="fixed"
        app:tabTextAppearance="@style/OuTabText"/>

    <FrameLayout
        android:id="@+id/manualContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
</LinearLayout>
