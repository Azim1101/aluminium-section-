<?xml version="1.0" encoding="utf-8"?>
<!-- ALU Window v3.0.0 — One UI share bottom sheet -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_sheet"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="28dp">

    <View android:layout_width="@dimen/ou_handle_w" android:layout_height="@dimen/ou_handle_h"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_sheet_handle"/>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="18dp" android:layout_marginStart="6dp"
        android:text="Share estimate"
        android:textColor="@color/txt" android:textSize="21sp"
        android:letterSpacing="-0.015" android:textStyle="bold"/>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:layout_marginBottom="18dp"
        android:layout_marginStart="6dp"
        android:text="Customer ko bhejne ka tarika chunein"
        android:textColor="@color/mut" android:textSize="13.5sp"/>

    <LinearLayout android:id="@+id/btnWhats" style="@style/SheetRow">
        <TextView style="@style/SheetRowIcon" android:text="📤"
            android:background="@drawable/bg_icon_tile"/>
        <LinearLayout style="@style/SheetRowTextBox">
            <TextView style="@style/SheetRowTitle" android:text="WhatsApp"/>
            <TextView style="@style/SheetRowSub" android:text="Quick text estimate"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:id="@+id/btnExcel" style="@style/SheetRow">
        <TextView style="@style/SheetRowIcon" android:text="📊"
            android:background="@drawable/bg_icon_tile"/>
        <LinearLayout style="@style/SheetRowTextBox">
            <TextView style="@style/SheetRowTitle" android:text="Excel (.xlsx)"/>
            <TextView style="@style/SheetRowSub" android:text="6 sheets — summary, cutting list, plan, RP, glass"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:id="@+id/btnCutImg" style="@style/SheetRow">
        <TextView style="@style/SheetRowIcon" android:text="🖼️"
            android:background="@drawable/bg_icon_tile"/>
        <LinearLayout style="@style/SheetRowTextBox">
            <TextView style="@style/SheetRowTitle" android:text="Cutting images"/>
            <TextView style="@style/SheetRowSub" android:text="Pipe cutting plan as pictures"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:id="@+id/btnBom" style="@style/SheetRow">
        <TextView style="@style/SheetRowIcon" android:text="📦"
            android:background="@drawable/bg_icon_tile"/>
        <LinearLayout style="@style/SheetRowTextBox">
            <TextView style="@style/SheetRowTitle" android:text="BOM order (WhatsApp)"/>
            <TextView style="@style/SheetRowSub" android:text="Supplier ke liye material list — pipe, glass, hardware"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
