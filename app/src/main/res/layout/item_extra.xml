<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:baselineAligned="false"
    android:gravity="center_vertical" android:paddingTop="4dp" android:paddingBottom="4dp">

    <LinearLayout android:layout_width="0dp" android:layout_weight="1"
        android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:id="@+id/tvXName"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="13sp" android:textStyle="bold" android:textColor="@color/txt"/>
        <TextView android:id="@+id/tvXInfo"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="10.5sp" android:textColor="@color/mut"/>
    </LinearLayout>

    <TextView android:id="@+id/tvXRate"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textSize="14sp" android:textStyle="bold" android:textColor="@color/ok"
        android:layout_marginEnd="8dp"/>

    <TextView android:id="@+id/btnXDel"
        android:layout_width="34dp" android:layout_height="34dp"
        android:gravity="center" android:text="✕"
        android:textSize="15sp" android:textColor="@color/red"/>
</LinearLayout>
