<?xml version="1.0" encoding="utf-8"?>
<!--
  ALU Window v3.0.0 — Samsung One UI home screen.
  Large-title header (28sp) + page dots + ViewPager2 + flat One UI bottom nav
  with a violet pill indicator behind the selected tab.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <!-- ============ ONE UI LARGE-TITLE HEADER ============ -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/bg"
        android:paddingStart="24dp"
        android:paddingEnd="14dp"
        android:paddingTop="14dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ou_app_kicker"
                style="@style/OuKicker"/>

            <TextView
                android:id="@+id/tvTitle"
                style="@style/OuTitle"
                android:layout_marginTop="2dp"
                android:text="Windows"/>

            <TextView
                android:id="@+id/tvSub"
                style="@style/OuCaption"
                android:layout_marginTop="3dp"
                android:textSize="13sp"
                android:text="0 windows"/>
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnPrice"
            style="@style/HeaderIcon"
            android:src="@drawable/ic_v2_rupee"
            android:contentDescription="Price"
            app:tint="@color/ic"/>

        <ImageButton
            android:id="@+id/btnProfile"
            style="@style/HeaderIcon"
            android:src="@drawable/ic_v2_person"
            android:contentDescription="Customers"
            app:tint="@color/ic"/>

        <ImageButton
            android:id="@+id/btnShare"
            style="@style/HeaderIcon"
            android:src="@drawable/ic_v2_share"
            android:contentDescription="Share"
            app:tint="@color/ic"/>

        <ImageButton
            android:id="@+id/btnSettings"
            style="@style/HeaderIcon"
            android:src="@drawable/ic_v2_sliders"
            android:contentDescription="Settings"
            app:tint="@color/ic"/>
    </LinearLayout>

    <!-- ============ PAGE DOTS ============ -->
    <LinearLayout
        android:id="@+id/dots"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingTop="2dp"
        android:paddingBottom="6dp"/>

    <!-- ============ CONTENT ============ -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <!-- ============ ONE UI FLAT BOTTOM NAV ============ -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_bottom_nav"
        android:minHeight="@dimen/ou_row_min"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:baselineAligned="false">

        <LinearLayout android:id="@+id/navWindows" style="@style/NavItem">
            <ImageView android:id="@+id/navWindowsIcon" style="@style/NavIcon"
                android:src="@drawable/ic_nav_windows" android:contentDescription="Windows"/>
            <TextView android:id="@+id/navWindowsText" style="@style/NavLabel" android:text="Windows"/>
        </LinearLayout>

        <LinearLayout android:id="@+id/navEstimate" style="@style/NavItem">
            <ImageView android:id="@+id/navEstimateIcon" style="@style/NavIcon"
                android:src="@drawable/ic_nav_estimate" android:contentDescription="Estimate"/>
            <TextView android:id="@+id/navEstimateText" style="@style/NavLabel" android:text="Estimate"/>
        </LinearLayout>

        <LinearLayout android:id="@+id/navCutting" style="@style/NavItem">
            <ImageView android:id="@+id/navCuttingIcon" style="@style/NavIcon"
                android:src="@drawable/ic_nav_cutting" android:contentDescription="Cutting"/>
            <TextView android:id="@+id/navCuttingText" style="@style/NavLabel" android:text="Cutting"/>
        </LinearLayout>

        <LinearLayout android:id="@+id/btnAiAgent" style="@style/NavItem">
            <ImageView android:id="@+id/navAiIcon" style="@style/NavIcon"
                android:src="@drawable/ic_v2_ai" android:contentDescription="AI Agent"/>
            <TextView android:id="@+id/navAiText" style="@style/NavLabel" android:text="AI"/>
        </LinearLayout>

        <LinearLayout android:id="@+id/btnMore" style="@style/NavItem">
            <ImageView android:id="@+id/navMoreIcon" style="@style/NavIcon"
                android:src="@drawable/ic_v2_more" android:contentDescription="More"/>
            <TextView android:id="@+id/navMoreText" style="@style/NavLabel" android:text="More"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
