<?xml version="1.0" encoding="utf-8"?>
<!-- ALU Window v3.0.0 — One UI extra-charge form -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/card"
    android:paddingStart="22dp" android:paddingEnd="22dp"
    android:paddingTop="18dp" android:paddingBottom="24dp">

    <TextView style="@style/FieldLabel" android:text="NAME" android:labelFor="@+id/xName"/>
    <EditText android:id="@+id/xName" android:layout_width="match_parent"
        android:layout_height="@dimen/ou_field_h" android:background="@drawable/bg_input"
        android:inputType="text" android:textSize="15sp"
        android:textColor="@color/txt" android:textColorHint="@color/hint"
        android:gravity="center_vertical"
        android:paddingStart="14dp" android:paddingEnd="14dp"
        android:hint="e.g. Lock, Handle, Labour"/>

    <TextView style="@style/FieldLabel" android:text="CHARGE BASIS"
        android:layout_marginTop="14dp" android:labelFor="@+id/xBasis"/>
    <Spinner android:id="@+id/xBasis" android:layout_width="match_parent"
        android:layout_height="@dimen/ou_field_h" android:background="@drawable/bg_input"/>

    <TextView style="@style/FieldLabel" android:text="APPLIES TO"
        android:layout_marginTop="14dp" android:labelFor="@+id/xSys"/>
    <Spinner android:id="@+id/xSys" android:layout_width="match_parent"
        android:layout_height="@dimen/ou_field_h" android:background="@drawable/bg_input"/>

    <TextView style="@style/FieldLabel" android:text="RATE (Rs)"
        android:layout_marginTop="14dp" android:labelFor="@+id/xRate"/>
    <EditText android:id="@+id/xRate" android:layout_width="match_parent"
        android:layout_height="@dimen/ou_field_h" android:background="@drawable/bg_input"
        android:inputType="numberDecimal" android:textSize="16sp"
        android:textColor="@color/txt"
        android:textStyle="bold" android:gravity="center" android:padding="8dp"/>
</LinearLayout>
