<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/acc</item>
        <item name="colorPrimaryDark">@color/accDark</item>
        <item name="colorAccent">@color/acc</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/accDark</item>
    </style>

    <style name="FieldBox">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:layout_marginEnd">5dp</item>
    </style>

    <style name="FieldLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">9.5sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/mut</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:layout_marginBottom">2dp</item>
    </style>

    <style name="FieldInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">42dp</item>
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:inputType">numberDecimal</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
        <item name="android:padding">4dp</item>
    </style>

    <style name="SecHead">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/acc</item>
        <item name="android:letterSpacing">0.09</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:layout_marginBottom">6dp</item>
    </style>
</resources>
